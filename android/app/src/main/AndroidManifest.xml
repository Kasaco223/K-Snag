<!-- Permisos: red, el servicio en primer plano del motor y las descargas, su notificación (se pide después de la
     primera descarga), mantener el celular despierto mientras baja, y escribir en Descargas solo en Android 8 y 9
     (desde el 10 se usa MediaStore). Nunca: android:extractNativeLibs (lo decide el build), SMS, accesibilidad ni
     lectura de notificaciones. El localeConfig lo genera el build (generateLocaleConfig). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- «Solo con Wi-Fi»: saber si la red tiene límite de datos (permiso normal, sin diálogo). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Actualizaciones de la app desde los Releases de GitHub (Android siempre pide confirmación). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".KdlApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/launcher_label"
        android:supportsRtl="true"
        android:theme="@style/Theme.KDL"
        tools:targetApi="33">

        <!-- Launcher y deep link kdownloader://download?url=… (la web y la app de Windows lo usan). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="download"
                    android:scheme="kdownloader" />
            </intent-filter>
        </activity>

        <!-- «Compartir» con texto y selección de texto: hoja translúcida en su propia tarea, fuera de Recientes.
             Usa la etiqueta de la app (launcher_label: «K-Snag», o «K-Snag (prueba)» / «K-Snag QA»
             en los builds de prueba) en el menú «Compartir» y en el de selección de texto. -->
        <activity
            android:name=".share.QuickDownloadActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.KDL.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Motor y descargas: servicio en primer plano (dataSync), solo para la propia app. -->
        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- «Cancelar» de la notificación de descarga. -->
        <receiver
            android:name=".download.NotificationActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!-- Android 8 y 9: abrir lo descargado desde la notificación y el historial. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/kd_file_paths" />
        </provider>
    </application>
</manifest>
